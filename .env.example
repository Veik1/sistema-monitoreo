# Configuración de variables de entorno para el Sistema de Monitoreo
# Copia este archivo como .env y ajusta los valores según tu configuración

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
# Usuario administrador de Grafana
GRAFANA_ADMIN_USER=admin

# Contraseña del administrador de Grafana
# IMPORTANTE: Cambia esto en producción
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# POSTGRESQL CONFIGURATION (usado por Zabbix)
# =============================================================================
# Usuario de la base de datos PostgreSQL
POSTGRES_USER=zabbix

# Contraseña de PostgreSQL
# IMPORTANTE: Cambia esto en producción
POSTGRES_PASSWORD=postgres

# Nombre de la base de datos
POSTGRES_DB=zabbix

# =============================================================================
# ZABBIX CONFIGURATION
# =============================================================================
# Nombre del servidor Zabbix (aparece en la interfaz web)
ZBX_SERVER_NAME=Sistema de Monitoreo Empresarial

# Zona horaria (ajustar según tu ubicación)
# Ejemplos: America/Mexico_City, America/New_York, Europe/Madrid, America/Bogota
TZ=America/Buenos_Aires

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. Este archivo NO debe ser commiteado a control de versiones
#    (ya está en .gitignore)
#
# 2. Asegúrate de cambiar TODAS las contraseñas por defecto en producción
#
# 3. Para crear el archivo .env desde este ejemplo:
#    - Windows: copy .env.example .env
#    - Linux/Mac: cp .env.example .env
#
# 4. Después de crear el .env, edita los valores según tu configuración
